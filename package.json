{
  "name": "dsh-marketplace-adapter",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Adapts a packaged skill marketplace into namespaced DSH skills.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "dsh-marketplace-adapter-sync": "./bin/sync.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/frontmatter.test.mjs && node test/discovery.test.mjs && node test/marketplace.test.mjs && node test/command.test.mjs && node test/provider.test.mjs && node test/mirror.test.mjs && node test/repository.test.mjs && node test/status.test.mjs",
    "sync": "node bin/sync.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "proper-lockfile": "4.1.2",
    "tar": "7.5.23",
    "yaml": "2.9.1"
  }
}
